{{define "body"}}
  {{/* Every project, which the index used to carry as an appendix. It lives
       here now: the index shows live work, and the answer to "where did SL7
       go" is a page rather than a block nobody reads top to bottom. */}}
  <section>
    <h2>projects</h2>
    {{if .ViewLinks}}
    {{/* The saved views of this listing. A view is a named question, so the
         picker is the list of questions somebody thought worth keeping. */}}
    <nav class="views">
      {{range .ViewLinks}}
      {{if .Current}}<span class="current" title="{{.Description}}">{{.Label}}</span>
      {{else}}<a href="{{.Href}}" title="{{.Description}}">{{.Label}}</a>{{end}}
      {{end}}
    </nav>
    {{end}}
    {{if .AllProjects}}
    <div class="tablewrap">
      <table>
        <thead><tr>
          <th>id</th><th>title</th><th>status</th><th>pri</th><th>effort</th>
          <th>open</th><th>issues</th><th>snoozed</th>
        </tr></thead>
        <tbody>
          {{range .AllProjects}}
          <tr class="depth{{.Depth}}{{if .Expired}} expired{{end}}">
            <td class="n"><a href="{{.Href}}">{{.ID}}</a></td>
            <td>{{.Title}}</td>
            <td>{{.Status}}</td>
            <td class="num">{{.Priority}}</td>
            <td>{{.Effort}}</td>
            <td class="num">{{if .Actions}}{{.Actions}}{{else}}·{{end}}</td>
            <td>{{range $i, $j := .Issues}}{{if $i}}, {{end}}{{template "issue" $j}}{{else}}-{{end}}</td>
            <td>{{if .Snoozed}}{{.Snoozed}}{{else}}-{{end}}</td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{else}}<p class="empty">no projects</p>{{end}}
  </section>
{{end}}
