<!doctype html>
<meta charset="utf-8">
<title>todo</title>
<h1>todo</h1>
<p>generated {{.GeneratedAt}}</p>

<h2>calendar — the next fortnight</h2>
<pre>{{.Calendar}}</pre>

<h2>queue — unblocked actions</h2>
<pre>{{.Queue}}</pre>

<h2>projects — active</h2>
<pre>{{.Projects}}</pre>
{{if .Live}}
{{/* The server streams a line on /events whenever the log moves. Reloading
     whole is crude and correct: the page is cheap to build and holds no state
     worth keeping. Comments inside <script> are stripped by html/template,
     which is why this one is out here. */}}
<script>new EventSource("/events").onmessage = () => location.reload();</script>
{{end}}